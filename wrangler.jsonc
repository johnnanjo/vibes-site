{
  "name": "vibes-site",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": true
  },
  "durable_objects": { "bindings": [{ "name": "COUNT_ROOM", "class_name": "CountRoom" }, { "name": "LABO", "class_name": "LaboAccounts" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CountRoom"] }, { "tag": "v2", "new_sqlite_classes": ["LaboAccounts"] }]
}
