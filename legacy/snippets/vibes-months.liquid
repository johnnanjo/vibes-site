{%- comment -%} 公式戦スケジュール：月ごとのカード（schedule-YYYY-MM 記事） compact: true でトップページ用の小さい表示 {%- endcomment -%}
{%- assign nowym = 'now' | date: '%Y%m' | plus: 0 -%}
{%- assign nowmm = nowym | modulo: 100 -%}{%- if nowmm == 12 -%}{%- assign nextym = nowym | plus: 89 -%}{%- else -%}{%- assign nextym = nowym | plus: 1 -%}{%- endif -%}
{%- assign b = blogs['news'] -%}
{%- assign yms = '' -%}
{%- for a in b.articles -%}
  {%- if a.handle contains 'schedule-' -%}
    {%- assign ym = a.handle | remove: 'schedule-' | remove: '-' | plus: 0 -%}
    {%- if ym >= nowym -%}{%- assign yms = yms | append: ym | append: ',' -%}{%- endif -%}
  {%- endif -%}
{%- endfor -%}
{%- assign yms = yms | split: ',' | uniq | sort -%}
{%- if yms.size > 0 -%}
{%- unless compact -%}
<style>
.vb .mo{margin:6px 0 30px}
.vb .mo-h{display:flex;align-items:baseline;gap:10px;margin:0 0 12px}
.vb .mo-h b{font-family:var(--anton);font-weight:400;font-size:1.5rem;letter-spacing:.01em}
.vb .mo-h span{font-size:14px;font-weight:700;color:var(--muted)}
.vb .mo-strip{display:grid;grid-auto-flow:column;grid-auto-columns:minmax(220px,1fr);gap:12px;overflow-x:auto;scroll-snap-type:x mandatory;padding-bottom:6px;-webkit-overflow-scrolling:touch}
.vb .mo-card{scroll-snap-align:start;display:flex;flex-direction:column;gap:6px;padding:18px 18px 20px;border-radius:18px;background:#F2F2EF;color:#0A0A09;text-decoration:none;border:2px solid transparent}
.vb .mo-card.cur{background:#0A0A09;color:#FAFAFA}
.vb .mo-card:hover{border-color:#FA4E02}
.vb .mo-card .yr{display:flex;justify-content:space-between;align-items:center;font-size:13px;font-weight:700;opacity:.75}
.vb .mo-card .yr i{font-style:normal;font-size:12px;font-weight:900;padding:3px 9px;border-radius:999px;background:#FA4E02;color:#0A0A09;opacity:1}
.vb .mo-card.cur .yr i{background:#C6FF1F}
.vb .mo-card .mn{font-family:var(--anton);font-size:56px;line-height:1;letter-spacing:.01em}
.vb .mo-card .mn small{font-family:var(--jp);font-weight:900;font-size:20px;margin-left:4px}
.vb .mo-card .tt{font-weight:900;font-size:15px}
.vb .mo-card .ex{font-size:13px;line-height:1.6;opacity:.8;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
.vb .mo-card .go{margin-top:auto;padding-top:8px;font-weight:900;font-size:14px;color:#FA4E02}
.vb .mo-card.cur .go{color:#C6FF1F}
@media (min-width:860px){.vb .mo-strip{grid-auto-flow:row;grid-template-columns:repeat(3,minmax(0,1fr));overflow:visible}}
</style>
<section class="mo" aria-label="月別の公式戦スケジュール">
  <div class="mo-h"><b>SCHEDULE</b><span>今後の公式戦を月ごとに</span></div>
  <div class="mo-strip">
  {%- for y in yms -%}
    {%- for a in b.articles -%}
      {%- assign ym = a.handle | remove: 'schedule-' | remove: '-' -%}
      {%- if a.handle contains 'schedule-' and ym == y -%}
        {%- assign yy = y | slice: 0, 4 -%}{%- assign mm = y | slice: 4, 2 | plus: 0 -%}
        {%- assign yn = y | plus: 0 -%}
        <a class="mo-card{% if yn == nowym %} cur{% endif %}" href="{{ a.url }}">
          <span class="yr">{{ yy }}{%- if yn == nowym -%}<i>今月</i>{%- elsif yn == nextym -%}<i>来月</i>{%- endif -%}</span>
          <span class="mn">{{ mm }}<small>月</small></span>
          <span class="tt">公式戦スケジュール</span>
          {%- assign ex = a.excerpt_or_content | strip_html | strip_newlines | truncate: 70 -%}
          {%- if ex != '' -%}<span class="ex">{{ ex }}</span>{%- endif -%}
          <span class="go">{{ mm }}月の大会を見る →</span>
        </a>
        {%- break -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endfor -%}
  </div>
</section>
{%- else -%}
<style>
.vb .mo-mini{display:flex;flex-wrap:wrap;gap:8px;margin:2px 0 12px}
.vb .mo-mini a{display:inline-flex;align-items:baseline;gap:4px;padding:8px 14px;border-radius:999px;background:#F2F2EF;color:#0A0A09;font-weight:900;font-size:14px;text-decoration:none}
.vb .mo-mini a.cur{background:#0A0A09;color:#C6FF1F}
.vb .mo-mini a b{font-family:var(--anton);font-weight:400;font-size:18px}
</style>
<div class="mo-mini" aria-label="月別の公式戦スケジュール">
  {%- for y in yms -%}
    {%- for a in b.articles -%}
      {%- assign ym = a.handle | remove: 'schedule-' | remove: '-' -%}
      {%- if a.handle contains 'schedule-' and ym == y -%}
        {%- assign mm = y | slice: 4, 2 | plus: 0 -%}{%- assign yn = y | plus: 0 -%}
        <a href="{{ a.url }}"{% if yn == nowym %} class="cur"{% endif %}><b>{{ mm }}</b>月の公式戦</a>
        {%- break -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endfor -%}
</div>
{%- endunless -%}
{%- endif -%}
