{%- comment -%} ホーム画面に追加（PWA）の案内。card: true でホームのカード、それ以外は全ページの小さなバナー＋手順シート {%- endcomment -%}
{%- if card -%}
<div class="ins-card" data-ins-card>
  <div class="ins-ic"><img src="https://cdn.shopify.com/s/files/1/0792/5533/9107/files/vibes-icon-official-512.png?v=1793790888&width=120" width="60" height="60" alt="" loading="lazy"></div>
  <div class="ins-tx">
    <b>VIBESアプリ、はじめました。</b>
    <span>ホーム画面に置けば、今日の大会・近くのビリヤード場・試合結果にいつでも1タップ。無料・登録なし・ダウンロード不要。</span>
  </div>
  <button type="button" class="ins-btn" data-ins-open>ホーム画面に追加</button>
  <a class="ins-more" href="/pages/app">VIBESアプリについて</a>
</div>
{%- else -%}
<style>
.ins-card{display:grid;grid-template-columns:60px 1fr;gap:12px 14px;align-items:center;margin:0 0 18px;padding:16px;border-radius:18px;background:#151514;box-shadow:inset 0 0 0 2px #FF2E93,0 0 24px rgba(255,46,147,.25);color:#F4F4F0}
.ins-card img{display:block;width:60px;height:60px;border-radius:14px}
.ins-card b{display:block;font-size:16px;font-weight:900;line-height:1.45;color:#fff}
.ins-card span{display:block;font-size:13px;line-height:1.6;color:#D9D9D3;margin-top:2px}
.ins-card .ins-more{grid-column:1 / -1;justify-self:center;font-size:13px;font-weight:700;color:#D9D9D3;text-decoration:underline;text-underline-offset:3px}
.ins-card .ins-btn{grid-column:1 / -1;min-height:50px;border:0;border-radius:999px;background:#FF2E93;color:#0A0A09;font:900 16px/1 "Noto Sans JP",system-ui,sans-serif;cursor:pointer}
html.vb-standalone .ins-card,html.vb-standalone .ins-bar{display:none!important}
.ins-bar{position:fixed;left:10px;right:10px;bottom:calc(80px + env(safe-area-inset-bottom,0px));z-index:58;display:none;align-items:center;gap:10px;padding:10px 10px 10px 12px;border-radius:16px;background:#0A0A09;color:#fff;box-shadow:0 0 0 2px #FF2E93,0 8px 30px rgba(0,0,0,.45);font-family:"Noto Sans JP",system-ui,sans-serif}
.ins-bar.on{display:flex}
.ins-bar img{width:40px;height:40px;border-radius:10px;flex:0 0 40px}
.ins-bar p{margin:0;flex:1;font-size:13px;font-weight:700;line-height:1.45}
.ins-bar p b{display:block;font-size:14px;font-weight:900;color:#FF2E93}
.ins-bar .go{border:0;border-radius:999px;background:#FF2E93;color:#0A0A09;font:900 14px/1 "Noto Sans JP",system-ui,sans-serif;padding:12px 14px;white-space:nowrap;cursor:pointer}
.ins-bar .x{border:0;background:none;color:#BDBDB6;font-size:22px;line-height:1;padding:6px;cursor:pointer}
.ins-sheet{position:fixed;inset:0;z-index:80;display:none;font-family:"Noto Sans JP",system-ui,sans-serif}
.ins-sheet.on{display:block}
.ins-sheet .bg{position:absolute;inset:0;background:rgba(10,10,9,.6)}
.ins-sheet .pn{position:absolute;left:0;right:0;bottom:0;max-height:86vh;overflow:auto;background:#0A0A09;color:#F4F4F0;border-radius:22px 22px 0 0;padding:22px 18px calc(24px + env(safe-area-inset-bottom,0px));box-shadow:0 -2px 0 #FF2E93}
.ins-sheet h3{margin:0 0 4px;font-size:20px;font-weight:900;color:#fff;font-family:inherit;text-transform:none;letter-spacing:0}
.ins-sheet .sub{margin:0 0 14px;font-size:14px;color:#D9D9D3}
.ins-sheet ol{list-style:none;margin:0;padding:0;display:grid;gap:10px;counter-reset:s}
.ins-sheet li{display:grid;grid-template-columns:36px 1fr;gap:12px;align-items:center;padding:12px;border-radius:14px;background:#1C1C1A;font-size:15px;font-weight:700;line-height:1.55;counter-increment:s}
.ins-sheet li::before{content:counter(s);display:grid;place-items:center;width:36px;height:36px;border-radius:50%;background:#FF2E93;color:#0A0A09;font-weight:900}
.ins-sheet li i{font-style:normal;display:inline-flex;align-items:center;justify-content:center;min-width:26px;height:26px;padding:0 6px;margin:0 2px;border-radius:7px;background:#F4F4F0;color:#0A0A09;font-size:14px;vertical-align:-6px}
.ins-sheet .why{margin:16px 0 0;padding:0;list-style:none;display:grid;gap:6px;font-size:14px;color:#E9E9E4}
.ins-sheet .why li{display:block;padding:0;background:none;font-weight:700}
.ins-sheet .why li::before{content:"✓ ";display:inline;width:auto;height:auto;background:none;color:#C6FF1F}
.ins-sheet .cl{display:block;width:100%;margin-top:18px;min-height:50px;border:0;border-radius:999px;background:#F4F4F0;color:#0A0A09;font:900 16px/1 "Noto Sans JP",system-ui,sans-serif;cursor:pointer}
.ins-sheet a.ext[hidden]{display:none}
.ins-sheet a.ext{display:block;margin-top:12px;padding:14px;border-radius:999px;background:#06C755;color:#fff;text-align:center;font-weight:900;text-decoration:none}
@media (min-width:760px){.ins-bar{display:none!important}}
</style>
<div class="ins-bar" id="ins-bar" role="region" aria-label="ホーム画面に追加">
  <img src="https://cdn.shopify.com/s/files/1/0792/5533/9107/files/vibes-icon-official-512.png?v=1793790888&width=80" alt="">
  <p><b>VIBESアプリ（無料）</b>ホーム画面から大会・近くのお店へ</p>
  <button type="button" class="go" data-ins-open>追加する</button>
  <button type="button" class="x" id="ins-x" aria-label="閉じる">×</button>
</div>
<div class="ins-sheet" id="ins-sheet" aria-hidden="true">
  <div class="bg" data-ins-close></div>
  <div class="pn" role="dialog" aria-modal="true" aria-labelledby="ins-h">
    <h3 id="ins-h">VIBESアプリをホーム画面に</h3>
    <p class="sub" id="ins-sub"></p>
    <ol id="ins-steps"></ol>
    <a class="ext" id="ins-ext" hidden>いつものブラウザで開く</a>
    <ul class="why"><li>アプリのように全画面で開ける</li><li>今日の大会・近くのビリヤード場に1タップ</li><li>無料・登録なし・容量もほとんど使いません</li></ul>
    <button type="button" class="cl" data-ins-close>閉じる</button>
  </div>
</div>
<script>
(function(){
  var d=document,h=d.documentElement,ua=navigator.userAgent;
  var standalone=matchMedia('(display-mode: standalone)').matches||navigator.standalone===true;
  if(standalone)return;
  var ios=/iPhone|iPad|iPod/.test(ua)||(navigator.platform==='MacIntel'&&navigator.maxTouchPoints>1);
  var line=/ Line\//i.test(ua),inapp=line||/Instagram|FBAN|FBAV|Twitter/i.test(ua);
  var crios=/CriOS/.test(ua);
  var sheet=d.getElementById('ins-sheet'),steps=d.getElementById('ins-steps'),sub=d.getElementById('ins-sub'),bar=d.getElementById('ins-bar'),ext=d.getElementById('ins-ext');
  var SHARE='<i><svg width="14" height="16" viewBox="0 0 14 16" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M7 1v9M3.5 4.5 7 1l3.5 3.5M2 7v8h10V7"/></svg></i>';
  function open(){
    if(window.vbInstallPrompt){var p=window.vbInstallPrompt;p.prompt();p.userChoice.finally?p.userChoice.finally(function(){window.vbInstallPrompt=null}):0;hideBar(30);return;}
    var html='';
    if(inapp){
      sub.textContent=line?'LINEの中のブラウザからは追加できません。いつものブラウザで開いてから追加してください。':'アプリ内のブラウザからは追加できません。いつものブラウザで開いてから追加してください。';
      html=line?'<li>右下（または右上）の <i>⋮</i> をタップ</li><li>「ブラウザで開く」をタップ</li><li>開いた画面で、もう一度「ホーム画面に追加」</li>':'<li>右上の <i>⋯</i> をタップ</li><li>「ブラウザで開く」をタップ</li><li>開いた画面で、もう一度「ホーム画面に追加」</li>';
      if(line){var u=location.href;ext.href=u+(u.indexOf('?')<0?'?':'&')+'openExternalBrowser=1';ext.hidden=false;}
    }else if(ios){
      sub.textContent=crios?'iPhoneのChromeでは、この手順で追加できます。':'iPhone・iPadのSafariでは、この手順で追加できます。';
      html=crios?'<li>右上の共有ボタン '+SHARE+' をタップ</li><li>「ホーム画面に追加」をタップ</li><li>右上の「追加」をタップ</li>':'<li>画面下の共有ボタン '+SHARE+' をタップ</li><li>下へスクロールして「ホーム画面に追加」をタップ</li><li>右上の「追加」をタップ</li>';
    }else{
      sub.textContent='Androidでは、この手順で追加できます。';
      html='<li>右上の <i>⋮</i> をタップ</li><li>「ホーム画面に追加」または「アプリをインストール」をタップ</li><li>「追加」または「インストール」をタップ</li>';
    }
    steps.innerHTML=html;sheet.classList.add('on');sheet.setAttribute('aria-hidden','false');
  }
  function close(){sheet.classList.remove('on');sheet.setAttribute('aria-hidden','true')}
  function hideBar(days){bar.classList.remove('on');try{localStorage.setItem('vibes-ins-hide',String(Date.now()+days*864e5))}catch(e){}}
  d.addEventListener('click',function(e){var t=e.target.closest('[data-ins-open],[data-ins-close]');if(!t)return;if(t.hasAttribute('data-ins-open'))open();else close();});
  d.getElementById('ins-x').addEventListener('click',function(){hideBar(14)});
  var until=0;try{until=+localStorage.getItem('vibes-ins-hide')||0}catch(e){}
  if(Date.now()>until&&!d.querySelector('.td-act')&&!/\/pages\/(near|app)/.test(location.pathname)){setTimeout(function(){bar.classList.add('on')},3500);}
  window.addEventListener('appinstalled',function(){hideBar(3650)});
  if(/[?&]install=1/.test(location.search))setTimeout(open,600);
})();
</script>
{%- endif -%}
