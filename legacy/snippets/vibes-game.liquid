{%- comment -%}
  メイン競技（ポケット／キャロム／ヘイボール）の選択と、サイト全体の絞り込み。
  render 'vibes-game', mode: 'chooser'  … トップ用の選択UI＋JS
  render 'vibes-game'                   … JS/CSSだけ（全ページ共通・タブバーから）
  保存先: localStorage vibes_game = pocket | carom | heyball（未選択＝すべて）
{%- endcomment -%}
{%- if mode == 'chooser' -%}
<style>
.vb .mg{margin:22px 0 0;padding:22px 18px 18px;border-radius:22px;background:#0A0A09;color:#F4F4F0;box-shadow:inset 0 0 0 2px rgba(255,255,255,.12)}
.vb .mg-en{font-family:var(--anton);font-size:clamp(26px,7.4vw,40px);line-height:1.05;letter-spacing:.01em;color:#fff}
.vb .mg-ja{margin:8px 0 0;font-size:13.5px;line-height:1.7;color:#C9C9C4}
.vb .mg-grid{display:grid;gap:10px;margin:16px 0 0}
@media (min-width:640px){.vb .mg-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}
.vb .mg-card{display:grid;gap:4px;justify-items:start;text-align:left;padding:16px 16px 14px;border:0;border-radius:16px;background:var(--mgc);color:#0A0A09;font-family:var(--jp);cursor:pointer;min-height:96px;box-shadow:0 0 0 0 #fff;transition:transform .12s,box-shadow .12s}
.vb .mg-card:active{transform:scale(.98)}
.vb .mg-card b{font-size:22px;font-weight:900;line-height:1.2}
.vb .mg-card small{font-family:var(--anton);font-size:12px;letter-spacing:.1em;opacity:.85}
.vb .mg-card span{font-size:12px;line-height:1.6;font-weight:700;opacity:.85;margin-top:4px}
.vb .mg-card.on{box-shadow:0 0 0 3px #0A0A09,0 0 0 6px #fff}
.vb .mg-card.on b::after{content:" ✓"}
.vb .mg-all{display:block;width:100%;margin:10px 0 0;padding:12px;border:0;border-radius:999px;background:transparent;box-shadow:inset 0 0 0 1.5px #5A5A56;color:#C9C9C4;font-family:var(--jp);font-size:13px;font-weight:700;cursor:pointer}
.vb .mg-bar{display:flex;align-items:center;justify-content:space-between;gap:12px;font-size:15px;font-weight:900}
.vb .mg-bar b{color:#C6FF1F}
.vb .mg-bar button{border:0;border-radius:999px;padding:9px 16px;background:#fff;color:#0A0A09;font-family:var(--jp);font-weight:900;font-size:13px;cursor:pointer}
.vb .mg-act{display:flex;gap:8px;align-items:center;flex-wrap:wrap;justify-content:flex-end}
.vb .mg-act a{display:inline-flex;align-items:center;min-height:34px;padding:0 14px;border-radius:999px;background:#C6FF1F;color:#0A0A09;font-size:13px;font-weight:900;text-decoration:none}
.vb .mg-bar{flex-wrap:wrap}
.vb .mg.is-set{padding:14px 18px}
.vb .mg.is-set .mg-en,.vb .mg.is-set .mg-ja,.vb .mg.is-set .mg-grid,.vb .mg.is-set .mg-all{display:none}
.vb .mg:not(.is-set) .mg-bar{display:none}
</style>
<section id="mygame" class="mg" data-vb-game-chooser aria-label="メインの競技">
  <div class="mg-en">What is your main game?</div>
  <p class="mg-ja">メインの競技を選ぶと、トップ・NEWS・試合結果・大会検索が、その競技の情報を先に出します。あとから変更できます。</p>
  <div class="mg-grid">
    <button type="button" class="mg-card" data-game="pocket" style="--mgc:#C6FF1F"><b>ポケット</b><small>POCKET</small><span>JPBA・JAPA・NBA関東支部ポケット・ハウストーナメント</span></button>
    <button type="button" class="mg-card" data-game="carom" style="--mgc:#00E1FF"><b>キャロム</b><small>3 CUSHION</small><span>JPBF・NBA関東・関東アマチュア3C連盟・関西アマチュア3C連盟・ハウストーナメント</span></button>
    <button type="button" class="mg-card" data-game="heyball" style="--mgc:#FA4E02"><b>ヘイボール</b><small>HEYBALL</small><span>日本HeyBall協会（HEYBALL JOY JAPAN）の大会</span></button>
  </div>
  <button type="button" class="mg-all" data-game="">選ばない（すべての競技を表示）</button>
  <div class="mg-bar"><span>メインの競技：<b data-mg-label></b></span><span class="mg-act"><a data-mg-link href="/">専用ページへ →</a><button type="button" data-mg-change>変更</button></span></div>
</section>
{%- endif -%}
<script>
(function(){
  if(window.VBGAME){ if(window.VBGAME.apply) window.VBGAME.apply(); return; }
  var K='vibes_game', TDB='vibes-tdb-my';
  var LBL={pocket:'ポケット',carom:'キャロム（スリークッション）',heyball:'ヘイボール（HEYBALL）'};
  var PAGE={pocket:'/pages/pocket',carom:'/pages/carom',heyball:'/pages/heyball-news'};
  function get(){ try{ var g=localStorage.getItem(K)||''; return (g==='pocket'||g==='carom'||g==='heyball')?g:''; }catch(e){ return ''; } }
  function set(g){
    try{ if(g) localStorage.setItem(K,g); else localStorage.removeItem(K); }catch(e){}
    try{ var m=JSON.parse(localStorage.getItem(TDB)||'{}')||{}; m.game=g?[g]:[]; localStorage.setItem(TDB,JSON.stringify(m)); }catch(e){}
    apply();
  }
  function isMine(txt,g){
    var t=(txt||'').toLowerCase();
    if(g==='heyball') return /ヘイボール|heyball/.test(t);
    if(g==='carom')   return /キャロム|スリークッション|3c|carom|3クッション/.test(t);
    if(g==='pocket')  return /ポケット|pocket/.test(t) && !/ヘイボール|heyball/.test(t);
    return false;
  }
  function reorder(g){
    document.querySelectorAll('.article-template .rte, .article-template__content, .vb-article .rte').forEach(function(rte){
      if(rte.dataset.vbSorted===g) return; rte.dataset.vbSorted=g;
      rte.querySelectorAll('.vb-mine').forEach(function(h){ h.classList.remove('vb-mine'); });
      var kids=Array.prototype.slice.call(rte.children), groups=[], cur={head:null,items:[]};
      kids.forEach(function(el){ if(el.tagName==='H2'){ groups.push(cur); cur={head:el,items:[]}; } else cur.items.push(el); });
      groups.push(cur);
      groups.forEach(function(grp){
        var blocks=[], b=null;
        grp.items.forEach(function(el){ if(el.tagName==='H3'){ b={h:el,els:[el]}; blocks.push(b); } else if(b){ b.els.push(el); } });
        if(blocks.length<2) return;
        var mine=blocks.filter(function(x){ return isMine(x.h.textContent,g); });
        if(!mine.length) return;
        var anchor=blocks[0].h;
        mine.reverse().forEach(function(x){ x.h.classList.add('vb-mine'); x.els.forEach(function(el,i){ anchor.parentNode.insertBefore(el, i===0?anchor:x.els[i-1].nextSibling); }); anchor=x.els[0]; });
      });
    });
  }
  function apply(){
    var g=get();
    document.documentElement.setAttribute('data-vb-game', g||'all');
    document.querySelectorAll('a[data-game],[data-game].entry,[data-game].post').forEach(function(el){
      var x=el.getAttribute('data-game'); el.hidden=!!(g && x && x!=='all' && x!==g);
    });
    document.querySelectorAll('a[href^="/pages/tournaments"]').forEach(function(a){
      try{ var u=new URL(a.getAttribute('href'),location.origin); if(g) u.searchParams.set('game',g); else u.searchParams.delete('game'); a.setAttribute('href',u.pathname+(u.search||'')); }catch(e){}
    });
    if(g) reorder(g);
    var ch=document.querySelector('[data-vb-game-chooser]');
    if(ch){
      ch.classList.toggle('is-set',!!g);
      ch.querySelectorAll('.mg-card').forEach(function(b){ b.classList.toggle('on',b.getAttribute('data-game')===g); });
      var l=ch.querySelector('[data-mg-label]'); if(l) l.textContent=LBL[g]||'';
      var lk=ch.querySelector('[data-mg-link]'); if(lk) lk.setAttribute('href',PAGE[g]||'/');
    }
  }
  document.addEventListener('click',function(e){
    var b=e.target.closest('[data-vb-game-chooser] [data-game]'); if(b){ var gg=b.getAttribute('data-game')||''; set(gg); if(gg && PAGE[gg]){ location.href=PAGE[gg]; } return; }
    var c=e.target.closest('[data-mg-change]'); if(c){ var ch=c.closest('[data-vb-game-chooser]'); if(ch) ch.classList.remove('is-set'); }
  });
  window.VBGAME={get:get,set:set,apply:apply};
  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',apply); else apply();
  document.addEventListener('DOMContentLoaded',apply);
})();
</script>
<style>
.rte h3.vb-mine::after{content:"あなたのメイン競技";display:inline-block;margin-left:10px;padding:2px 10px;border-radius:999px;background:#C6FF1F;color:#0A0A09;font-size:11px;font-weight:900;letter-spacing:0;vertical-align:middle;line-height:1.6}
</style>
