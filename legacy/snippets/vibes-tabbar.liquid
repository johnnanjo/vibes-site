{%- liquid
  assign p = request.path
  assign cur = 'home'
  if p contains '/blogs/news'
    assign cur = 'news'
  elsif p contains '/blogs/results'
    assign cur = 'results'
  elsif p contains '/blogs/house-tournament' or p contains '/pages/tournament-form'
    assign cur = 'house'
  elsif p contains '/pages/tournaments'
    assign cur = 'db'
  elsif p != '/'
    assign cur = ''
  endif
-%}
{{ 'vibes-v21.css' | asset_url | stylesheet_tag }}
{{ 'vibes-v46.css' | asset_url | stylesheet_tag }}
{%- render 'vibes-v21-fix' -%}
<style>
@media (max-width:759px){
  .vb-tab{grid-template-columns:repeat(6,1fr)!important;padding:6px 2px calc(6px + env(safe-area-inset-bottom,0px))!important;align-items:start}
  .vb-tab a{gap:4px!important;font-size:11px!important;font-weight:900!important;color:#FFFFFF!important;letter-spacing:0;line-height:1.15;text-align:center}
  .vb-tab .ic{width:32px;height:32px;border-radius:50%;display:grid;place-items:center;color:#fff;transition:transform .15s}
  .vb-tab .ic svg{width:18px!important;height:18px!important}
  .vb-tab a:active .ic{transform:scale(.92)}
  .vb-tab .c-home .ic{background:#F4F4F0;color:#0A0A09}
  .vb-tab .c-news .ic{background:#FA4E02;color:#0A0A09}
  .vb-tab .c-res .ic{background:#F5B700;color:#0A0A09}
  .vb-tab .c-house .ic{background:#12B5A5}
  .vb-tab .c-carom .ic{background:#2F6FD6}
  .vb-tab .c-pocket .ic{background:#FF2E93;color:#0A0A09}
  .vb-tab .c-carom .ic svg,.vb-tab .c-pocket .ic svg{width:20px!important;height:20px!important}
  .vb-tab a[aria-current="page"]{color:#C6FF1F!important}
  .vb-tab a[aria-current="page"] .ic{box-shadow:0 0 0 2px #0A0A09,0 0 0 4px #C6FF1F,0 0 14px #C6FF1F!important}
  .vb-tab a[aria-current="page"]::before{display:none}
  body{padding-bottom:calc(80px + env(safe-area-inset-bottom,0px))!important}
}
</style>
<nav class="vb-tab" aria-label="メインナビゲーション">
  <a class="c-home" href="/" {% if cur == 'home' %}aria-current="page"{% endif %}><span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round" aria-hidden="true"><path d="M4 11 12 4l8 7v9h-5v-6H9v6H4z"/></svg></span>ホーム</a>
  <a class="c-news" data-type="official" href="/pages/tournaments?type=official" {% if cur == 'news' %}aria-current="page"{% endif %}><span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><rect x="3.5" y="5" width="17" height="15" rx="2.5"/><path d="M3.5 10h17M8 3v4M16 3v4"/></svg></span>公式戦</a>
  <a class="c-res" href="/blogs/results" {% if cur == 'results' %}aria-current="page"{% endif %}><span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round" aria-hidden="true"><path d="M7 4h10v5a5 5 0 0 1-10 0zM7 6H4v2a3 3 0 0 0 3 3M17 6h3v2a3 3 0 0 1-3 3M12 14v3M8.5 20h7"/></svg></span>結果</a>
  <a class="c-house" data-type="house" href="/pages/tournaments?type=house" {% if cur == 'house' %}aria-current="page"{% endif %}><span class="ic"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.5" fill="none" stroke="currentColor" stroke-width="2.2"/><path d="M4.6 8.5h14.8v7H4.6z" fill="currentColor"/><circle cx="12" cy="12" r="2.6" fill="#12B5A5"/></svg></span>ハウス大会</a>
  <a class="c-carom" href="/pages/live-table?mode=carom"><span class="ic"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="7.2" r="4.3" fill="#E5322D" stroke="#0A0A09" stroke-width="1.4"/><circle cx="7" cy="16" r="4.3" fill="#FFFFFF" stroke="#0A0A09" stroke-width="1.4"/><circle cx="17" cy="16" r="4.3" fill="#FFD400" stroke="#0A0A09" stroke-width="1.4"/></svg></span>キャロム<br>ゲーム</a>
  <a class="c-pocket" href="/pages/live-table?mode=pocket"><span class="ic"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.6" fill="#0A0A09"/><circle cx="12" cy="12" r="4" fill="#FFFFFF"/><text x="12" y="14.6" text-anchor="middle" font-family="Arial,sans-serif" font-weight="900" font-size="7.4" fill="#0A0A09">8</text></svg></span>ポケット<br>ゲーム</a>
</nav>
{%- if cur == 'db' -%}
<script>(function(){var t=new URLSearchParams(location.search).get('type');var a=document.querySelector('.vb-tab a[data-type="'+t+'"]');if(a)a.setAttribute('aria-current','page');})();</script>
{%- endif -%}
{%- render 'vibes-install' -%}
{%- render 'vibes-game' -%}
