{%- when 'feature' -%}{%- case code -%}{%- when 'handicap' -%}ハンデ戦{%- when 'doubles' -%}ダブルス{%- when 'beginner_welcome' -%}初心者歓迎{%- when 'women_welcome' -%}女性歓迎{%- when 'stream' -%}配信あり{%- when 'free_watch' -%}観戦無料{%- when 'same_day_entry' -%}当日受付あり{%- endcase -%}
