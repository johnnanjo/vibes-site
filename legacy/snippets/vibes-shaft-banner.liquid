        <pattern id="sb-dots" width="10" height="10" patternUnits="userSpaceOnUse"><circle cx="5" cy="5" r="1.9" fill="#0A0A09"/></pattern>
        <linearGradient id="sb-fade" x1="0" y1="0" x2="1" y2="1"><stop offset=".38" stop-color="#000"/><stop offset="1" stop-color="#fff"/></linearGradient>
        <mask id="sb-mask"><rect width="600" height="600" fill="#000"/><circle cx="330" cy="310" r="200" fill="url(#sb-fade)"/></mask>
      </defs>
      <circle cx="330" cy="310" r="200" fill="url(#sb-ball)"/>
      <circle cx="330" cy="310" r="200" fill="url(#sb-dots)" mask="url(#sb-mask)"/>
      <polygon points="20,596 46,562 526,64 536,82" fill="#0A0A09"/>
      <line x1="40" y1="578" x2="528" y2="74" stroke="#FFFFFF" stroke-width="2.2" opacity=".55"/>
      <polygon points="526,64 536,82 556,62 546,44" fill="#FFFFFF"/>
      <polygon points="556,62 546,44 562,36 570,52" fill="#0A0A09"/>
    </svg>
  </span>
  <span class="k"><i>PATTERN ORDER</i>パターンオーダー<br>カーボンシャフト</span>
  <span class="vt">VIBES <b>CARBON SHAFT</b></span>
  <span class="big">Build<br>your<br>one.</span>
  <span class="sub"><b>¥25,000</b>税込・送料込｜1本から・名入れ込み｜納期3〜4週間</span>
  <span class="cta">専用ページへ</span>
</a>
