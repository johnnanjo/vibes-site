<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@700;800&family=Oswald:wght@600;700&family=Noto+Sans+JP:wght@400;700;900&display=swap">
