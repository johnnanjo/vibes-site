{%- assign today = 'now' | date: '%Y%m%d' | plus: 0 -%}
{%- assign up = '~' -%}
{%- paginate shop.metaobjects.tournament.values by 250 -%}
  {%- for t in shop.metaobjects.tournament.values -%}
    {%- if t.shop.value -%}
      {%- assign endd = t.ends_at.value | default: t.starts_at.value | date: '%Y%m%d' | plus: 0 -%}
      {%- if endd >= today -%}{%- assign up = up | append: '~' | append: t.shop.value.system.handle | append: '~' -%}{%- endif -%}
    {%- endif -%}
  {%- endfor -%}
{%- endpaginate -%}
{%- assign up = up | append: 'x' -%}
<style>
.vb .nr{padding:18px 0 40px;max-width:760px}
.vb .nr-hero{position:relative;overflow:hidden;margin:6px 0 0;padding:28px 20px 24px;border-radius:22px;color:#F4F4F0;
  background:radial-gradient(90% 70% at 100% 0%,rgba(0,225,255,.32),transparent 60%),radial-gradient(80% 60% at 0% 100%,rgba(198,255,31,.22),transparent 60%),#0A0A09;box-shadow:inset 0 0 0 2px rgba(0,225,255,.6),0 0 30px rgba(0,225,255,.18)}
.vb .nr-hero .k{font-family:var(--anton);font-size:clamp(40px,12vw,64px);line-height:.95;color:#00E1FF;text-shadow:0 0 8px rgba(0,225,255,.6),0 0 26px rgba(0,225,255,.35)}
.vb .nr-hero h1{font-family:var(--jp);font-weight:900;font-size:clamp(22px,6.4vw,30px);line-height:1.35;margin:10px 0 6px;color:#fff;text-transform:none;letter-spacing:0}
.vb .nr-hero p{margin:0;font-size:15px;line-height:1.7;color:#E2E2DC}
.vb .nr-go{position:relative;display:flex;align-items:center;justify-content:center;gap:10px;width:100%;min-height:58px;margin-top:20px;border:0;border-radius:999px;background:#C6FF1F;color:#0A0A09;font:900 17px/1.2 var(--jp);cursor:pointer;box-shadow:0 0 22px rgba(198,255,31,.45)}
.vb .nr-go[disabled]{opacity:.7}
.vb .nr-go .pin{width:22px;height:22px}
.vb .nr-go.busy .pin{animation:nrpulse 1s ease-in-out infinite}
@keyframes nrpulse{50%{transform:scale(1.25)}}
.vb .nr-gm{display:flex;align-items:center;justify-content:center;gap:8px;min-height:50px;margin-top:10px;border-radius:999px;color:#fff;text-decoration:none;font-weight:900;font-size:15px;box-shadow:inset 0 0 0 2px #fff}
.vb .nr-q{display:flex;gap:8px;margin:16px 0 0}
.vb .nr-q input{flex:1;min-width:0;min-height:50px;padding:0 16px;border:2px solid #0A0A09;border-radius:999px;font:700 16px/1 var(--jp);background:#fff;color:#0A0A09}
.vb .nr-q button{min-height:50px;padding:0 20px;border:0;border-radius:999px;background:#0A0A09;color:#00E1FF;font:900 15px/1 var(--jp);cursor:pointer}
.vb .nr-msg{margin:16px 0 0;font-size:14px;font-weight:700;line-height:1.7;color:var(--muted)}
.vb .nr-msg.err{color:#C42B00}
.vb .nr-list{margin:18px 0 0}
.vb .nr-c{display:grid;gap:4px;padding:14px 16px;margin:10px 0;border-radius:16px;background:#fff;border:1px solid #E2E2DE;border-left:7px solid #00E1FF}
.vb .nr-c.hit{border-left-color:#C6FF1F;box-shadow:0 0 0 2px #C6FF1F}
.vb .nr-c .top{display:flex;justify-content:space-between;align-items:baseline;gap:10px}
.vb .nr-c .nm{font-size:17px;font-weight:900;line-height:1.4;color:#0A0A09;text-decoration:none}
.vb .nr-c .km{font-family:var(--anton);font-size:22px;white-space:nowrap;color:#0A0A09}
.vb .nr-c .km small{font-family:var(--jp);font-size:12px;font-weight:700;margin-left:2px}
.vb .nr-c .ad{font-size:13px;line-height:1.6;color:#4A4A46}
.vb .nr-c .ev{justify-self:start;font-size:12px;font-weight:900;padding:3px 10px;border-radius:999px;background:#C6FF1F;color:#0A0A09;text-decoration:none}
.vb .nr-c .approx{font-size:11px;font-weight:700;color:#8A8A86}
.vb .nr-c .bt{display:flex;gap:8px;margin-top:8px}
.vb .nr-c .bt a{flex:1;display:flex;align-items:center;justify-content:center;min-height:44px;border-radius:999px;font-weight:900;font-size:14px;text-decoration:none;box-shadow:inset 0 0 0 2px #0A0A09;color:#0A0A09}
.vb .nr-c .bt a.rt{background:#0A0A09;color:#C6FF1F;box-shadow:none}
.vb .nr-pref{display:flex;flex-wrap:wrap;gap:8px;margin:14px 0 0}
.vb .nr-pref button{min-height:42px;padding:0 16px;border-radius:999px;border:1.5px solid #0A0A09;background:#fff;font:700 14px/1 var(--jp);color:#0A0A09;cursor:pointer}
.vb .nr-pref button.on{background:#0A0A09;color:#C6FF1F}
.vb .nr-note{margin:22px 0 0;font-size:12px;line-height:1.7;color:var(--muted)}
.vb .nr-shopcta{margin:24px 0 0;padding:18px;border-radius:16px;background:#F2F2EF;font-size:14px;line-height:1.7}
.vb .nr-shopcta a{color:#0A0A09;font-weight:900;text-decoration:underline;text-decoration-color:#FA4E02;text-decoration-thickness:3px}
@media (prefers-reduced-motion:reduce){.vb .nr-go.busy .pin{animation:none}}
</style>
<div class="vb">
<div class="wrap">
<section class="nr">
  <div class="crumbs"><a href="/">Vibes Billiards</a> ／ 近くのビリヤード場</div>
  <div class="nr-hero">
    <div class="k">Near Me</div>
    <h1>いる場所から、<br>近くのビリヤード場へ。</h1>
    <p>現在地から近い順に、全国のビリヤード場と開催予定の大会を表示します。位置情報はこの画面の中だけで使い、保存や送信はしません。</p>
    <button class="nr-go" id="nr-go" type="button"><svg class="pin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.6"/></svg><span>現在地から探す</span></button>
    <a class="nr-gm" id="nr-gm" href="https://www.google.com/maps/search/%E3%83%93%E3%83%AA%E3%83%A4%E3%83%BC%E3%83%89%E5%A0%B4" target="_blank" rel="noopener">Googleマップで周辺をすべて見る</a>
  </div>
  <form class="nr-q" id="nr-q" role="search" action="/pages/near">
    <input type="search" name="q" id="nr-qi" placeholder="店名・駅・市区町村で探す" aria-label="店名・駅・市区町村で探す" autocomplete="off">
    <button type="submit">検索</button>
  </form>
  <p class="nr-msg" id="nr-msg" aria-live="polite"></p>
  <div class="nr-list" id="nr-list"></div>
  <div id="nr-prefbox" hidden>
    <p class="nr-msg">位置情報を使わない場合は、都道府県からえらべます。</p>
    <div class="nr-pref" id="nr-pref"></div>
  </div>
  <div class="nr-shopcta">全国のビリヤード場を掲載しています（ビリウォーカーの公開情報・店舗からの情報・読者からの情報をもとに随時更新）。新しいお店や閉店・移転を見つけたら、<a href="https://line.me/R/ti/p/@361mehjz" target="_blank" rel="noopener">公式LINE</a>に「閉店　店名:○○」のように送ってください。すぐにサイトに反映します。</div>
  <p class="nr-note">距離は直線距離の目安です。営業時間・空き状況は各店舗にご確認ください。お店の位置は国土地理院の住所検索で求めています。店舗情報の出典：<a href="https://billi-walker.jp/bwpoolhall/" target="_blank" rel="noopener">ビリウォーカー</a>ほか。</p>
</section>
</div>
</div>
